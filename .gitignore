# ---- Phong thi nghiem ----
# Tu thoi diem nay MOI rule duoi day deu co dau '/' o DAU. Khong co dau '/' thi
# git khop o BAT KY cấp thư mục nào, và rule an hienh se lam an nham file
# trong src/ - vi du 'build/' se an `scripts/build/` neu mai no la thu muc.
/scratch/
/src_clone/
/src_clone.bak_*/
/src_clone.bak_*.user.js
/youtube-tools-clone.user.js
/youtube-ambilight-local/
/antigravity_export/
/scripts/build-clone.js
/scripts/build_clone.*
/scripts/verify-clone.ps1

# ---- Rac cu (chi o goc repo) ----
# PHAI CO DAU '/' O DAU. Khong co dau '/' thi git khop o BAT KY do sau,
# ke ca trong src/ - vi du 'fix*.js' se an luon src/features/fixPlaylist.js,
# mot file source that. Da kiem bang 'git check-ignore'.
/replace.js
/_backup_*
/fix*.js
/patch_*.js
*.bak
*.zip
