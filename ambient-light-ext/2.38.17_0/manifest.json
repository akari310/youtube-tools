{
   "action": {
      "default_icon": {
         "16": "images/icon-16.png",
         "24": "images/icon-24.png",
         "32": "images/icon-32.png"
      },
      "default_popup": "options.html"
   },
   "author": "Wessel Kroos",
   "background": {
      "scripts": [ "scripts/background.js" ],
      "service_worker": "scripts/background.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "strict_min_version": "121.0"
      }
   },
   "content_scripts": [ {
      "exclude_matches": [ "https://www.youtube.com/live_chat*", "https://www.youtube.com/embed/*" ],
      "js": [ "scripts/content.js" ],
      "matches": [ "https://www.youtube.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "js": [ "scripts/content.js" ],
      "matches": [ "https://www.youtube.com/embed/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [ "styles/live-chat.css" ],
      "exclude_matches": [ "https://www.youtube.com/live_chat?is_popout=1*" ],
      "js": [ "scripts/live-chat.js" ],
      "matches": [ "https://www.youtube.com/live_chat*" ],
      "run_at": "document_start"
   } ],
   "description": "Immerse yourself in YouTube™ videos with ambient light!",
   "homepage_url": "https://github.com/WesselKroos/youtube-ambilight",
   "icons": {
      "128": "images/icon-128.png",
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "121",
   "name": "Ambient light for YouTube™",
   "options_ui": {
      "open_in_tab": false,
      "page": "options.html"
   },
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.38.17",
   "web_accessible_resources": [ {
      "matches": [ "https://www.youtube.com/*" ],
      "resources": [ "styles/content.css", "scripts/content-main.js", "scripts/injected.js", "images/noise-1.png", "images/noise-2.png", "images/noise-3.png", "images/donate.svg" ]
   } ]
}
